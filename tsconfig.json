{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // strict incluye noImplicitAny, strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitThis,
    // useUnknownInCatchVariables y alwaysStrict. Las propiedades obligatorias
    // de los DTO (poblados por class-transformer) usan asignación definida (!).
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // "multer" es necesario: registra la augmentación global Express.Multer.File.
    // Sin él, ts-node (compilación lazy) falla en controladores con @UploadedFile
    // aunque tsc (programa completo) pase, porque nadie cargó @types/multer aún.
    "types": ["jest", "node", "multer"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
