# ============================================================
# Raices Backend - Variables de entorno (plantilla)
# Copia este archivo a `.env` (desarrollo local y despliegue).
# NUNCA subas archivos .env al repositorio.
# En Cloud Run, los secretos se montan desde GCP Secret Manager:
#   gcloud run deploy ... --set-secrets=FIREBASE_CREDENTIALS=projects/<PROJECT>/secrets/FIREBASE_CREDENTIALS:latest
# ============================================================

# ---- App ----------------------------------------------------
NODE_ENV=development
PORT=7000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_DEPENDIENTES_POR_TUTOR=5

# ---- Rate limiting / ETag -------------------------------------
# Limite global de peticiones por IP (por defecto 60/min) y ventana en ms
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
# TTL de la cache de ETag en memoria (ms)
ETAG_CACHE_TTL_MS=30000

# ---- Firebase -----------------------------------------------
# ID del proyecto GCP/Firebase
FIREBASE_PROJECT_ID=tu-proyecto-gcp
# API key web de Firebase Auth (el cliente la expone; aqui se usa en el server)
FIREBASE_API_KEY=

# SECRETO: JSON completo de la cuenta de servicio, en UNA sola linea
# (sin saltos de linea), p. ej. el contenido del archivo serviceAccount.json.
# Nombre canonico: FIREBASE_CREDENTIALS. Alias retrocompatible: FIREBASE_SERVICE_ACCOUNT.
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"tu-proyecto-gcp","private_key":"-----BEGIN PRIVATE KEY-----...","client_email":"firebase-adminsdk-...@tu-proyecto-gcp.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token",...}

# Bucket de Cloud Storage (opcional; si se omite se deriva de FIREBASE_PROJECT_ID)
FIREBASE_STORAGE_BUCKET=

# ---- IA (Vertex AI / Gemini) --------------------------------
# Autenticacion via ADC: en Cloud Run usa la cuenta de servicio adjunta;
# en local, `gcloud auth application-default login`.
VERTEX_AI_PROJECT_ID=tu-proyecto-gcp
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash

# ---- Email (Resend) -----------------------------------------
# SECRETO: API key de Resend (montada desde Secret Manager en produccion)
RESEND_API_KEY=
